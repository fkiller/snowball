* text=auto

# Linux container, router, and firmware sources must keep LF endings.
*.c text eol=lf
*.h text eol=lf
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf

# These helpers execute directly in Windows PowerShell.
*.ps1 text eol=crlf

# Media and firmware artifacts are binary when deliberately versioned.
*.bin binary
*.wav binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
