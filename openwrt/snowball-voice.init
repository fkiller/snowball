#!/bin/sh /etc/rc.common

# Use the host's existing Docker service. This service owns only the
# snowball-voice container; it does not launch dockerd or manage Docker data.
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/snowball-voice-start

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 10 5
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
