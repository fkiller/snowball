CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# esp_peer's 8 KiB RTP/jitter pools must live in PSRAM.  The IDF default
# (16 KiB) routes those pools to internal DRAM, leaving only a 15,360-byte
# contiguous block immediately after esp_peer_open and tripping the DTLS
# preflight.  Keep only small control allocations internal and retain the
# 32 KiB internal reserve for DMA/Wi-Fi.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_HIESP=y
# The board's long-idle trace captured a real
# "Cache disabled but cached memory region accessed" panic.  Keep flash
# operations from suspending the cache while the AFE/Wi-Fi paths are using
# Execute the application from PSRAM while the main flash is being accessed.
# The helper selects both PSRAM instruction/rodata placement and, crucially,
# keeps the cache mapping usable during SPI1 flash operations.  Selecting only
# the two placement symbols leaves the ESP32-S3 vulnerable to the exact
# "Cache error / MMU entry fault" seen when the Wi-Fi task overlaps the first
# HTTPS/CA request.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# mbedTLS must use PSRAM for its large handshake buffers. The WakeNet
# pipeline leaves only a small contiguous internal DRAM block; keeping TLS on
# the internal heap caused the observed -0x7F00 setup failure.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# MultiNet command-tail recognition is enabled for the deployed development
# image. The measured build retains the TLS contiguous-memory gate; the
# free-form request is still streamed to ChatGPT and is never transcribed on
# the board.
CONFIG_SNOWBALL_COMMAND_TAIL=y
CONFIG_SNOWBALL_HEAP_DIAGNOSTICS=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
