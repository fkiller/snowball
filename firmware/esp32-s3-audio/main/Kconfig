menu "Snowball"

config SNOWBALL_COMMAND_TAIL
    bool "Enable the English wake-word command tail"
    default y
    help
        Use the measured MultiNet command recognizer after WakeNet. The free-
        form request still stays in the Gateway/ChatGPT media stream.

